# Code style: IntelliJ IDEA defaults, plus braces always forced around if / for / while / do bodies and no control
# statement on one line. IntelliJ IDEA applies the ij_* properties (Reformat Code); other editors use the basic ones.
# Ported legacy code is not reformatted (it stays byte-identical to the cited code apart from package / import lines
# and class renames); this style applies to code written for this repository.
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = space
indent_size = 4
tab_width = 4
continuation_indent_size = 8
max_line_length = 120
ij_continuation_indent_size = 8
ij_java_if_brace_force = always
ij_java_for_brace_force = always
ij_java_while_brace_force = always
ij_java_do_while_brace_force = always
ij_java_keep_control_statement_in_one_line = false
ij_java_keep_simple_blocks_in_one_line = false
ij_java_keep_simple_methods_in_one_line = false
ij_java_keep_simple_lambdas_in_one_line = false
ij_java_keep_simple_classes_in_one_line = false

[*.{xml,pom}]
indent_style = space
indent_size = 4

[*.{md,py,sh}]
indent_style = space
indent_size = 4

[*.{json,tsv,gz}]
# data files: never touched by editors
charset = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
